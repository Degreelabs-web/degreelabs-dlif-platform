APP_NAME=DLIF Platform API
APP_VERSION=0.1.0
ENVIRONMENT=development

CORS_ORIGINS=http://localhost:3000

DATABASE_URL=

SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Private Supabase Storage bucket for mentor profile photographs. The API uses
# the service-role key to upload and issue short-lived signed image URLs.
MENTOR_HEADSHOT_STORAGE_BUCKET=dlif-mentor-headshots
MENTOR_HEADSHOT_MAX_UPLOAD_MB=5
MENTOR_HEADSHOT_SIGNED_URL_TTL_SECONDS=600

# Private Supabase Storage bucket for student profile photographs.
STUDENT_PHOTO_STORAGE_BUCKET=dlif-student-photos
STUDENT_PHOTO_MAX_UPLOAD_MB=5
STUDENT_PHOTO_SIGNED_URL_TTL_SECONDS=600

# SMTP email delivery (example values for Google Workspace)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=admin@degreelabs.com
SMTP_PASSWORD=
SMTP_FROM_EMAIL=admin@degreelabs.com
SMTP_FROM_NAME=DegreeLabs
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT_SECONDS=10

# Optional dedicated key for encrypted 2FA challenges. Use a random 32+ character value.
# When blank, SUPABASE_SERVICE_ROLE_KEY is used as the server-only key material.
TWO_FACTOR_CHALLENGE_SECRET=
TWO_FACTOR_CHALLENGE_TTL_SECONDS=300

# Automatic enrollment workbook synchronization
ENROLLMENT_SYNC_ENABLED=false
# Supported values: local, google_sheets
ENROLLMENT_EXCEL_SOURCE_TYPE=local
ENROLLMENT_EXCEL_SOURCE=
# Used by the Admin "Upload Excel" action, including when Google Sheets is
# configured as the primary source.
ENROLLMENT_UPLOAD_SOURCE=data/enrollment-upload.xlsx
ENROLLMENT_STUDENT_SHEET=Students
ENROLLMENT_MENTOR_SHEET=Mentors

# Private Google Sheets mentor source. Share the sheet as Viewer with the
# service account's client_email, then set ENROLLMENT_EXCEL_SOURCE_TYPE=google_sheets.
ENROLLMENT_GOOGLE_SPREADSHEET_ID=
ENROLLMENT_GOOGLE_MENTOR_RANGE=Form responses 1!A:AZ
ENROLLMENT_GOOGLE_SERVICE_ACCOUNT_FILE=
# Long random value sent by the Google Apps Script form-submit trigger.
ENROLLMENT_GOOGLE_WEBHOOK_SECRET=
# When true, imported mentors remain pending until an Admin approves them.
MENTOR_ONBOARDING_REQUIRES_APPROVAL=false
ENROLLMENT_SYNC_INTERVAL_MINUTES=5
ENROLLMENT_INVITE_REDIRECT_URL=http://localhost:3000/login
ENROLLMENT_UPLOAD_MAX_MB=10

# ---------------------------------------------------------------------------
# Google Calendar / Meet Integration
# ---------------------------------------------------------------------------
# Set to true once all credentials below are filled in.
GOOGLE_MEET_ENABLED=false

# OAuth 2.0 credentials for the dedicated scheduling Google account
# (e.g. scheduling@yourorg.com). Create these in Google Cloud Console:
#   APIs & Services → Credentials → OAuth 2.0 Client IDs (Web application)
# Required scopes:
#   https://www.googleapis.com/auth/calendar
#   https://www.googleapis.com/auth/calendar.events
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Long-lived refresh token obtained via OAuth consent flow for the
# scheduling account. Workspace accounts do not auto-expire refresh tokens
# unless explicitly revoked.
GOOGLE_CALENDAR_REFRESH_TOKEN=

# Calendar to create events on. 'primary' = scheduling account's own
# calendar. Replace with a calendar ID for a shared/resource calendar.
GOOGLE_CALENDAR_ID=primary

# IANA timezone used for all calendar events (must match your session times).
GOOGLE_CALENDAR_TIMEZONE=UTC
